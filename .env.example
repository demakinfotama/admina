APP_NAME=Admina
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

DB_HOST=localhost
DB_NAME=admina_db
DB_USER=your_db_user
DB_PASS=your_db_password

# ============================================================
# Konfigurasi Email (PHPMailer via SMTP)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
# tls = port 587 | ssl = port 465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Admina App"

# Token untuk web installer (composer-install.php)
# Isi dengan string acak yang kuat, hapus setelah vendor/ terbuat
COMPOSER_INSTALL_TOKEN=
